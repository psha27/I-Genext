PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Production: set NODE_ENV=production, DATABASE_URL, and serve over HTTPS.
# Apply database/schema.sql for a new database, or database/migrations/002_contact_acknowledgements.sql for an existing one.
# DATABASE_URL=mysql://user:password@localhost:3306/igenext
# Development without DATABASE_URL uses server/data.
# Create the admin account with npm run admin:setup from the project root.
# ADMIN_CREDENTIALS_FILE=absolute/path/to/admin-credentials.json

EMAIL_FROM=info@i-genext.com
EMAIL_REPLY_TO=info@i-genext.com
EMAIL_RESPONSE_TIME=two business days
# Microsoft Entra application with Graph Mail.Send application permission and admin consent.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Recruitment notifications include the candidate resume. Uses the same Microsoft 365 sender.
CAREERS_EMAIL=careers@i-genext.com
# Optional development directory (production uses MySQL):
# CAREERS_DATA_DIR=absolute/path/to/private/careers
# Existing databases also need database/migrations/003_careers.sql.

# Insights CMS: apply database/migrations/004_insights_cms.sql to existing MySQL databases.
# Route /insights/ as well as /api/ to Express in production.
PUBLIC_SITE_URL=
META_GRAPH_VERSION=v25.0
# Required in production to store social tokens: random 32 bytes, base64 encoded.
SOCIAL_ENCRYPTION_KEY=
# Optional private directory for development insights and encrypted social settings:
# INSIGHTS_DATA_DIR=absolute/path/to/private/insights
