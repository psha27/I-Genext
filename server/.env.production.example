# I-GENEXT PRODUCTION CONFIGURATION
# PRIVATE: keep this file on the backend server, outside client/dist.
# Deployment: copy this file to server/.env on the production server.
# The app does NOT automatically load .env.production.
# Replace CHANGE_ME and example.com before starting production.

# Runtime and public URLs (exact HTTPS origin, no trailing slash).
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://example.com
PUBLIC_SITE_URL=https://example.com

# MySQL: initialize database/schema.sql on a fresh database first.
# URL-encode special characters in the username/password (e.g. @ becomes %40).
# Replace hostname/port/database if your hosting provider supplies different values.
DATABASE_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:3306/igenext"

# Private persistent paths: Linux examples; adapt to your hosting environment.
# Create these directories and grant the backend service account access.
# Set the same paths for admin setup and the backend process.
ADMIN_CREDENTIALS_FILE=/var/lib/igenext/admin-credentials.json
HERO_DATA_DIR=/var/lib/igenext/hero
PLATFORM_CATALOG_DIR=/var/lib/igenext/platform-catalog
PLATFORM_MEDIA_DIR=/var/lib/igenext/platform-media

# Admin username/password are NOT read from environment variables.
# Run npm run admin:setup on the server to create the hashed credentials file.

# Email identities: replace if your Microsoft 365 mailbox differs.
EMAIL_FROM=info@i-genext.com
EMAIL_REPLY_TO=info@i-genext.com
CAREERS_EMAIL=careers@i-genext.com
EMAIL_RESPONSE_TIME="two business days"

# Microsoft 365 / Entra application credentials, supplied by your tenant admin.
# Requires Graph Mail.Send application permission and admin consent.
# Leave all three blank to keep email delivery unconfigured (messages are queued).
# Quote secrets containing # or spaces. Never place them in client-side variables.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Social publishing: existing configured API version, review when enabling accounts.
META_GRAPH_VERSION=v25.0
# Private 32-byte base64 encryption key. Back up; do not change after storing tokens.
# This key encrypts social tokens; it is not a Microsoft/Google credential.
SOCIAL_ENCRYPTION_KEY=
# Social account IDs and access tokens are configured in Admin > Insights > Social accounts.

# Development-only storage overrides; production metadata uses MySQL instead.
# DATA_DIR=/path/to/development/contact-data
# CAREERS_DATA_DIR=/path/to/development/careers-data
# INSIGHTS_DATA_DIR=/path/to/development/insights-data

# Google Analytics G-228473648P is a public identifier in client/index.html.
# No Google Analytics secret or AI API key is required by this website.
